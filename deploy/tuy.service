[Unit]
Description=To'y taklifnomasi (Django + Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/tuy
EnvironmentFile=/var/www/tuy/.env
ExecStart=/var/www/tuy/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 3 --timeout 60
Restart=always

[Install]
WantedBy=multi-user.target
